<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?android:attr/colorBackground" android:padding="16dp" tools:context=".MainActivity">
    <!--  Nagłówek identyfikujący studenta  -->
    <TextView android:id="@+id/tvStudentHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:text="LAB 08 - Material Design | Anna 105575" android:textColor="?android:attr/textColorPrimary" android:textSize="16sp" android:textStyle="bold" android:gravity="center" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
