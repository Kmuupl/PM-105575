<resources xmlns:tools="http://schemas.android.com/tools">
    <!--  Motyw aplikacji dla trybu ciemnego (Dark Mode)  -->
    <!--  Przygotowane przez Anna 105575  -->
    <style name="Theme.LAB08App" parent="Theme.Material3.DayNight.NoActionBar">
        <!--  Kolory główne w trybie nocnym  -->
        <item name="colorPrimary">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary_dark</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <!--  Nadpisanie ról kolorów dla karty i tekstów w trybie nocnym  -->
